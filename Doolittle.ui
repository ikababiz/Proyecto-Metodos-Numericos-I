&lt;p align=&quot;justify&quot; style=&quot; margin-top:4px; margin-bottom:6px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-weight:600; color:#000000;&quot;&gt;1. Cálculo de los elementos de &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-weight:600; font-style:italic; color:#000000;&quot;&gt;L&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-weight:600; color:#000000;&quot;&gt; y &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-weight:600; font-style:italic; color:#000000;&quot;&gt;U&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-weight:600; color:#000000;&quot;&gt; (Factorización):&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot;&gt; Con &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-style:italic; color:#000000;&quot;&gt;u&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-style:italic; color:#000000; vertical-align:sub;&quot;&gt;ii&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot;&gt; = 1 para &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-style:italic; color:#000000;&quot;&gt;i&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot;&gt; = 1, ..., &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-style:italic; color:#000000;&quot;&gt;n&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot;&gt; se alterna el cálculo de cada columna &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-style:italic; color:#000000;&quot;&gt;j&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot;&gt; de &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-style:italic; color:#000000;&quot;&gt;L&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot;&gt; y cada fila &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-style:italic; color:#000000;&quot;&gt;j&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot;&gt; de &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-style:italic; color:#000000;&quot;&gt;U&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot;&gt; para &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-style:italic; color:#000000;&quot;&gt;j&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot;&gt; = 1, 2, ..., &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; font-style:italic; color:#000000;&quot;&gt;n&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot;&gt;:&lt;/span&gt;&lt;/p&gt;
&lt;ul type=&quot;square&quot; style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'Segoe UI,Arial,sans-serif'; color:#000000;&quot; align=&quot;justify&quot; style=&quot; margin-top:4px; margin-bottom:6px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Elementos de la matriz triangular inferior &lt;span style=&quot; font-style:italic;&quot;&gt;L&lt;/span&gt; (&lt;span style=&quot; font-style:italic;&quot;&gt;i&lt;/span&gt; = &lt;span style=&quot; font-style:italic;&quot;&gt;j&lt;/span&gt;, &lt;span style=&quot; font-style:italic;&quot;&gt;j&lt;/span&gt; + 1, ..., &lt;span style=&quot; font-style:italic;&quot;&gt;n&lt;/span&gt;):&lt;/li&gt;&lt;/ul&gt;
