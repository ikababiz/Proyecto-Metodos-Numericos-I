        </font>
       </property>
       <property name="text">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-family:'Helvetica'; color:#000000;&quot;&gt;¿Para qué sirve?&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-family:'Helvetica'; color:#000000;&quot;&gt;El &lt;/span&gt;&lt;span style=&quot; font-family:'Helvetica'; font-weight:600; color:#000000;&quot;&gt;método de la bisección&lt;/span&gt;&lt;span style=&quot; font-family:'Helvetica'; color:#000000;&quot;&gt; es un algoritmo numérico utilizado para encontrar raíces&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-family:'Helvetica'; color:#000000;&quot;&gt;reales (ceros) de ecuaciones no lineales de la forma:&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-family:'Helvetica'; color:#000000;&quot;&gt;f (x) = 0&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-family:'Helvetica'; color:#000000;&quot;&gt;Se emplea cuando no es posible o resulta demasiado complejo despejar la variable x de&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-family:'Helvetica'; color:#000000;&quot;&gt;forma analítica (por ejemplo, en ecuaciones trascendentes como e^(−x) − cos(x) = 0).&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
      </widget>
